# ─────────────────────────────────────────────────────────────────
# AI DPDP Compliance Platform — Environment Variables
# Copy this to .env and fill in real values
# ─────────────────────────────────────────────────────────────────

# ── Application ──────────────────────────────────────────────────
APP_NAME="DPDP Shield"
APP_VERSION="1.0.0"
APP_ENV="development"   # development | production
SECRET_KEY="your-super-secret-key-change-in-production-min-32-chars"
DEBUG=true

# ── Database (PostgreSQL + pgvector) ─────────────────────────────
POSTGRES_USER=dpdp
POSTGRES_PASSWORD=dpdp_secret
POSTGRES_DB=dpdp_compliance
DATABASE_URL="postgresql+asyncpg://dpdp:dpdp_secret@localhost:5432/dpdp_compliance"

# ── Redis (Celery broker) ─────────────────────────────────────────
REDIS_URL="redis://localhost:6379/0"

# ── AI / LLM ─────────────────────────────────────────────────────
# Get your Gemini API key at: https://makersuite.google.com/app/apikey
GEMINI_API_KEY="your-gemini-api-key-here"
GEMINI_MODEL="gemini-1.5-flash"
EMBEDDING_MODEL="models/text-embedding-004"

# Optionally use OpenAI instead
# OPENAI_API_KEY="your-openai-api-key-here"

# ── Storage ───────────────────────────────────────────────────────
UPLOAD_DIR="uploads"
MAX_FILE_SIZE_MB=50
ALLOWED_EXTENSIONS="pdf,docx,csv,xlsx,txt,png,jpg,jpeg"

# ── OCR ───────────────────────────────────────────────────────────
# Path to tesseract binary (usually auto-detected)
# TESSERACT_CMD="/usr/bin/tesseract"

# ── Frontend ──────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL="http://localhost:8000/api/v1"

# ── CORS ──────────────────────────────────────────────────────────
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# ── Report Generation ─────────────────────────────────────────────
REPORTS_DIR="reports"
