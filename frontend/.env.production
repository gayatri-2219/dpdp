# DPDP Shield Frontend — Vercel Config
# This file lives inside /frontend and is used when deploying just the frontend directory

[build]
  command = "npm run build"
  publish = ".next"

[build.environment]
  # Set this in Vercel Dashboard → Project → Settings → Environment Variables
  NEXT_PUBLIC_API_URL = "https://your-backend.railway.app/api/v1"
